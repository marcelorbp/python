    print("\n📊 Per-file breakdown:")
    for filepath, funcs, asserts, loc in per_file:
        percent_loc = (loc / totals["loc"] * 100) if totals["loc"] > 0 else 0
        print(f"{filepath}: funcs={funcs}, asserts={asserts}, loc={loc} ({percent_loc:.2f}% of total LOC)")

    print("\n✅ Overall totals:")
    print(f"Functions: {totals['funcs']}")
    print(f"Asserts:   {totals['asserts']}")
    print(f"LOC:       {totals['loc']}")

    # Export results to CSV
    export_to_csv(per_file, totals, output_path="code_report.csv")
    print("\n📂 Report saved to code_report.csv")
